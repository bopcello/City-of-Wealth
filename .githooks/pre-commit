#!/bin/sh
# Gitleaks pre-commit hook

# Locate gitleaks executable
GITLEAKS_BIN="gitleaks"
if ! command -v gitleaks >/dev/null 2>&1; then
  if [ -n "$LOCALAPPDATA" ] && [ -f "$LOCALAPPDATA/Microsoft/WinGet/Links/gitleaks.exe" ]; then
    GITLEAKS_BIN="$LOCALAPPDATA/Microsoft/WinGet/Links/gitleaks.exe"
  elif [ -f "C:/Users/Salil/AppData/Local/Microsoft/WinGet/Links/gitleaks.exe" ]; then
    GITLEAKS_BIN="C:/Users/Salil/AppData/Local/Microsoft/WinGet/Links/gitleaks.exe"
  fi
fi

echo "[Gitleaks Hook] Running pre-commit secret scan on staged changes..."
"$GITLEAKS_BIN" protect --staged --verbose
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo "=================================================================="
  echo " [GITLEAKS ERROR] Secret leak detected in staged files!"
  echo " Commit blocked. Remove the sensitive key or update .gitleaks.toml"
  echo "=================================================================="
  exit $EXIT_CODE
fi
